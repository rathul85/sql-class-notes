--group by
-- how many males and females are there
--aggregate function sum(),avg(),count()
select
gender,
count(*) as "customer numbers"
from public."DimCustomers" 
group by gender;

--how many males & females customers are registrerd per city
select
gender,
city,
count(*) as "customer numbers"
from public."DimCustomers" 
group by gender,city
order by 2;

--how many  customers are registrerd per city
select
city,
count(*) as "customer numbers"
from public."DimCustomers" 
group by city
order by 1;

--how many males & females customers are registrerd per city who use gmail
--how many males & females customers are registrerd per city
select
gender,
city,
count(*) as "customer numbers"
from public."DimCustomers" 
where email ilike('%gmail%')
group by gender,city
order by 2;


select
gender,
city,
count(*) as "customer numbers"
from public."DimCustomers" 
group by gender,city
having count(*)>5
order by 2;


