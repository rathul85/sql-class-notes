-- CASE STATEMENT

-- Divide the products into high value and low value categories
-- if the product's unit_price > avg price then high value, otherwise low value
--AVG price=187.3170731707317073

select 
*,
case
   when unit_price>187.3170731707317073 THEN 'High Value Product'
   when  unit_price=187.3170731707317073 THEN 'Average Value Product'
   ELSE 'Low Value Product'
End as "product category"
from public."DimProducts";  

--subquery
select 
*,
case
   when unit_price>(select avg(unit_price) from public."DimProducts") THEN 'High Value Product'
   when  unit_price=(select avg(unit_price) from public."DimProducts") THEN 'Average Value Product'
   ELSE 'Low Value Product'
End as "product category"
from public."DimProducts"  

--how many high value products are in each category
-- first i will take the only high value products
select 
*
from (select 
*,
case
   when unit_price>(select avg(unit_price) from public."DimProducts") THEN 'High Value Product'
   when  unit_price=(select avg(unit_price) from public."DimProducts") THEN 'Average Value Product'
   ELSE 'Low Value Product'
End as "product category"
from public."DimProducts"  
)sub_table
where "product category"='High Value Product'


select 
category,
count(*) as "total produts"
from (select 
*,
case
   when unit_price>(select avg(unit_price) from public."DimProducts") THEN 'High Value Product'
   when  unit_price=(select avg(unit_price) from public."DimProducts") THEN 'Average Value Product'
   ELSE 'Low Value Product'
End as "product category"
from public."DimProducts"  
)sub_table
where "product category"='High Value Product'
group by category
order by 2 desc 







