--self join
-- Product Affinity
-- Which pair of products are more likely to be bought together
--Product affinity is the process of uncovering the mystery behind which items people tend to buy together
select 
o1.product_id as product_1,
o2.product_id as product_2
from "FactOrderItems" o1
join "FactOrderItems" o2 on o1.order_id=o2.order_id 
and o1.product_id<o2.product_id


