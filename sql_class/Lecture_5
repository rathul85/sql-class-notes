-- CTE: Common Table Expression
with top_pair_product as(
	SELECT 
	oi1.product_id AS product_1, 
	oi2.product_id AS product_2, 
	COUNT(*) AS times_ordered_together 
	FROM "FactOrderItems" oi1 
	JOIN "FactOrderItems" oi2 ON (oi1.order_id = oi2.order_id)
	AND oi1.product_id < oi2.product_id 
	GROUP BY oi1.product_id, oi2.product_id 
	ORDER BY times_ordered_together DESC 
	LIMIT 10
)
select  
product_1,
p1.product_name as "product_1" ,
product_2,
p2.product_name as "product_2" ,
times_ordered_together
from top_pair_product tp
left join "DimProducts" P1 on p1.product_id=tp.product_1
left join "DimProducts" P2 on p2.product_id=tp.product_2

